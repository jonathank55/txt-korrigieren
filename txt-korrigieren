def get_active_rules(style_mode: Any = None) -> List[Dict[str, Any]]:
    if not style_mode:
        return list(DETERMINISTIC_RULES)
    mode = str(style_mode).lower().strip()
    if mode in ["all", "ja", "true", "1"]:
        return DETERMINISTIC_RULES + STYLE_RULES
    elif mode == "floskeln":
        return DETERMINISTIC_RULES + [r for r in STYLE_RULES if "Floskel" in r["rule"] or "Nominalstil" in r["rule"]]
    elif mode == "pleonasmen":
        return DETERMINISTIC_RULES + [r for r in STYLE_RULES if "Pleonasmus" in r["rule"] or "Tautologie" in r["rule"]]
    elif mode == "nominalstil":
        return DETERMINISTIC_RULES + [r for r in STYLE_RULES if "Nominalstil" in r["rule"] or "Funktionsverb" in r["rule"]]
    return DETERMINISTIC_RULES + STYLE_RULES

def create_backup(file_path: str) -> Optional[str]:
    """Erstellt eine atomare .bak-Sicherung und registriert sie im zentralen Archiv."""
    if not os.path.exists(file_path):
        return None
    
    bak_path = f"{file_path}.bak"
    try:
        shutil.copy2(file_path, bak_path)
    except Exception as e:
        sys.stderr.write(f"[BACKUP_ERROR] Lokales Backup fehlgeschlagen: {e}\n")
        return None

    # 1. Zentrales Backup via file_backup_engine.py (falls vorhanden)
    if os.path.exists(BACKUP_SCRIPT):
        try:
            subprocess.run([sys.executable, BACKUP_SCRIPT, file_path], capture_output=True, timeout=60)
        except Exception:
            pass
    else:
        # 2. Standalone-Archivierung (völlig unabhängig von externen Systemen)
        try:
            from datetime import datetime
            today = datetime.now().strftime("%Y-%m-%d")
            archive_dir = os.environ.get("XDG_DATA_HOME", os.path.expanduser(f"~/.local/share/txt-korrigieren/backups/{today}"))
            os.makedirs(archive_dir, exist_ok=True)
            timestamp = datetime.now().strftime("%H%M%S")
            filename = os.path.basename(file_path)
            shutil.copy2(file_path, os.path.join(archive_dir, f"{filename}_{timestamp}.bak"))
        except Exception:
            pass

    return bak_path

def export_to_downloads_txt(file_path: str, text_content: str) -> str:
    """Exportiert den bereinigten Text als .txt-Datei direkt im Downloads-Ordner."""
    downloads_dir = os.path.expanduser("~/Downloads")
    os.makedirs(downloads_dir, exist_ok=True)
    base_name = os.path.splitext(os.path.basename(file_path))[0]
    out_path = os.path.join(downloads_dir, f"{base_name}.txt")
    with open(out_path, "w", encoding="utf-8") as f:
        f.write(text_content)
    return out_path

class TextAuditResult:
    def __init__(self, file_path: str):
        self.file_path = file_path
        self.file_type = os.path.splitext(file_path)[1].lower()
        self.findings: List[Dict[str, Any]] = []
        self.modifications_count = 0
        self.status = "clean"
        self.backup_path: Optional[str] = None
        self.exported_txt_path: Optional[str] = None

    def to_dict(self) -> Dict[str, Any]:
        return {
            "file_path": self.file_path,
            "file_type": self.file_type,
            "status": self.status,
            "modifications_count": self.modifications_count,
            "backup_path": self.backup_path,
            "exported_txt_path": self.exported_txt_path,
            "findings_count": len(self.findings),
            "findings": self.findings
        }

def apply_rule_to_runs(p, rule: Dict[str, Any], apply_fix: bool = False) -> List[Dict[str, Any]]:
    """Wendet eine deterministische Regel formatgetreu auf die Runs eines Absatzes an."""
    findings = []
    p_text = p.text
    pattern = re.compile(rule["pattern"])
    
    matches = list(pattern.finditer(p_text))
    if not matches:
        return findings

    for match in matches:
        orig = match.group(0)
        corrected = orig

        if "replacement_map" in rule:
            corrected = rule["replacement_map"].get(orig.lower(), orig)
        elif "replacement_str" in rule:
            corrected = pattern.sub(rule["replacement_str"], orig)

        if orig == corrected:
            continue

        finding = {
            "original": orig,
            "corrected": corrected,
            "rule": rule["rule"],
            "reference": rule["reference"]
        }
        findings.append(finding)

        if apply_fix:
            # 1. Versuch: Liegt orig exakt in einem Run?
            replaced = False
            for r in p.runs:
                if orig in r.text:
                    r.text = r.text.replace(orig, corrected, 1)
                    replaced = True
                    break
            
            # 2. Spezifische Behandlung für isolierte Teilwörter (z. B. 'einen' vor 'von vielen Beispielen')
            if not replaced and rule["id"] == "indefinitpronomen_genus_beispiel":
                for r in p.runs:
                    if r.text.strip() == "einen":
                        r.text = r.text.replace("einen", "eines", 1)
                        replaced = True
                        break

            # 3. Spezifische Behandlung für Gedankenstrich ohne Leerzeichen
            if not replaced and rule["id"] == "gedankenstrich_abstand_nach":
                for idx, r in enumerate(p.runs):
                    if r.text == "—" and idx + 1 < len(p.runs):
                        next_r = p.runs[idx + 1]
                        if next_r.text and not next_r.text.startswith(" "):
                            next_r.text = " " + next_r.text
                            replaced = True
                            break

    return findings

def audit_and_fix_docx(file_path: str, apply_fix: bool = False, style_mode: bool = False) -> TextAuditResult:
    active_rules = get_active_rules(style_mode)
    """Verarbeitet .docx-Dokumente formatgetreu über Runs und Absätze."""
    result = TextAuditResult(file_path)
    try:
        import docx
    except ImportError:
        result.findings.append({
            "error": "Bibliothek python-docx nicht verfügbar."
        })
        result.status = "error"
        return result

    try:
        doc = docx.Document(file_path)
    except Exception as e:
        result.findings.append({
            "error": f"Word-Datei konnte nicht geladen werden: {e}"
        })
        result.status = "error"
        return result

    modified = False

    # Absatz- & Run-Durchlauf
    for p_idx, p in enumerate(doc.paragraphs):
        p_text = p.text
        if not p_text.strip():
            continue

        for rule in active_rules:
            findings = apply_rule_to_runs(p, rule, apply_fix=apply_fix)
            for f in findings:
                f["paragraph"] = p_idx
                result.findings.append(f)
                if apply_fix:
                    modified = True
                    result.modifications_count += 1

    if apply_fix and modified:
        bak = create_backup(file_path)
        doc.save(file_path)
        # Obligatorische Bereinigung: Lokale .bak nach erfolgreicher Speicherung löschen
        if bak and os.path.exists(bak):
            try:
                os.remove(bak)
            except Exception:
                pass
        # Obligatorischer .txt-Export im Downloads-Ordner
        try:
            full_text = "\n\n".join(p.text for p in doc.paragraphs if p.text.strip())
            result.exported_txt_path = export_to_downloads_txt(file_path, full_text)
        except Exception:
            pass
        result.status = "fixed"
    elif len(result.findings) > 0:
        result.status = "findings_detected"
    else:
        result.status = "clean"

    return result

def audit_and_fix_plain(file_path: str, apply_fix: bool = False, style_mode: bool = False) -> TextAuditResult:
    """Verarbeitet Text-, Markdown- und Typst-Dateien."""
    active_rules = get_active_rules(style_mode)
    """Verarbeitet Text-, Markdown- und Typst-Dateien."""
    result = TextAuditResult(file_path)
    try:
        with open(file_path, "r", encoding="utf-8") as f:
            content = f.read()
    except Exception as e:
        result.findings.append({"error": f"Datei konnte nicht gelesen werden: {e}"})
        result.status = "error"
        return result

    new_content = content
    modified = False

    for rule in active_rules:
        pattern = re.compile(rule["pattern"])
        for match in pattern.finditer(content):
            orig = match.group(0)
            corrected = orig

            if "replacement_map" in rule:
                corrected = rule["replacement_map"].get(orig.lower(), orig)
            elif "replacement_str" in rule:
                corrected = pattern.sub(rule["replacement_str"], orig)

            if orig == corrected:
                continue

            result.findings.append({
                "original": orig,
                "corrected": corrected,
                "rule": rule["rule"],
                "reference": rule["reference"]
            })

            if apply_fix and corrected != orig:
                new_content = new_content.replace(orig, corrected)
                modified = True
                result.modifications_count += 1

    if apply_fix and modified:
        bak = create_backup(file_path)
        tmp_target = f"{file_path}.tmp_fix_{os.getpid()}"
        with open(tmp_target, "w", encoding="utf-8") as f:
            f.write(new_content)
        os.replace(tmp_target, file_path)
        # Obligatorische Bereinigung: Lokale .bak nach erfolgreicher Speicherung löschen
        if bak and os.path.exists(bak):
            try:
                os.remove(bak)
            except Exception:
                pass
        # Obligatorischer .txt-Export im Downloads-Ordner
        try:
            result.exported_txt_path = export_to_downloads_txt(file_path, new_content)
        except Exception:
            pass
        result.status = "fixed"
    elif len(result.findings) > 0:
        result.status = "findings_detected"
    else:
        result.status = "clean"

    return result

def to_rtf_escapes(s: str) -> str:
    """Wandelt Sonderzeichen in Standard-RTF-Escapes um."""
    char_map = {
        'ä': r"\'e4",
        'ö': r"\'f6",
        'ü': r"\'fc",
        'Ä': r"\'c4",
        'Ö': r"\'d6",
        'Ü': r"\'dc",
        'ß': r"\'df",
        '–': r"\endash ",
        '—': r"\emdash ",
        '„': r"\'84",
        '“': r"\'93",
        '”': r"\'94",
        '‚': r"\'82",
        '‘': r"\'91",
        '’': r"\'92"
    }
    out = []
    for c in s:
        if c in char_map:
            out.append(char_map[c])
        elif ord(c) > 127:
            out.append(f"\\u{ord(c)}?")
        else:
            out.append(c)
    return "".join(out)

