def fix_infinitiv_mit_zu(m):
    full = m.group(0)
    zu = m.group(1)
    verb = m.group(2) + m.group(3)
    if any(verb.endswith(k) for k in KNOWN_INFINITIVES_TEN):
        return full
    if verb.endswith('ten'):
        return f"{zu}{verb[:-3]}en"
    elif verb.endswith('tet'):
        return f"{zu}{verb[:-3]}en"
    return full

