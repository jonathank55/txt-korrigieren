    active_rules = get_active_rules(style_mode)
    """Verarbeitet RTF-Dateien sowie RTFD-Bundles."""
    result = TextAuditResult(file_path)
    
    is_bundle = os.path.isdir(file_path) or file_path.lower().endswith(".rtfd")
    target_rtf = os.path.join(file_path, "TXT.rtf") if is_bundle else file_path
    
    if not os.path.exists(target_rtf):
        result.findings.append({"error": f"RTF-Zieldatei existiert nicht: {target_rtf}"})
        result.status = "error"
        return result

    try:
        with open(target_rtf, "r", encoding="latin1") as f:
            rtf_content = f.read()
    except Exception as e:
        result.findings.append({"error": f"RTF-Datei konnte nicht gelesen werden: {e}"})
        result.status = "error"
        return result

    # Plaintext-Extraktion via textutil
    try:
        res = subprocess.run(["textutil", "-convert", "txt", "-stdin", "-stdout"],
                             input=rtf_content.encode("latin1"), capture_output=True, timeout=10)
        plain_text = res.stdout.decode("utf-8")
    except Exception:
        plain_text = rtf_content

    new_rtf_content = rtf_content
    modified = False

    for rule in active_rules:
        pattern = re.compile(rule["pattern"])
        for match in pattern.finditer(plain_text):
            orig = match.group(0)
            corrected = orig

            if "replacement_map" in rule:
                corrected = rule["replacement_map"].get(orig.lower(), orig)
            elif "replacement_str" in rule:
                corrected = pattern.sub(rule["replacement_str"], orig)

            if orig == corrected:
                continue

            result.findings.append({
                "original": orig,
                "corrected": corrected,
                "rule": rule["rule"],
                "reference": rule["reference"]
            })

            if apply_fix and corrected != orig:
                if orig in new_rtf_content:
                    new_rtf_content = new_rtf_content.replace(orig, corrected)
                    modified = True
                    result.modifications_count += 1
                else:
                    orig_rtf = to_rtf_escapes(orig)
                    corrected_rtf = to_rtf_escapes(corrected)
                    if orig_rtf in new_rtf_content:
                        new_rtf_content = new_rtf_content.replace(orig_rtf, corrected_rtf)
                        modified = True
                        result.modifications_count += 1

    if apply_fix and modified:
        bak = create_backup(target_rtf)
        tmp_target = f"{target_rtf}.tmp_fix_{os.getpid()}"
        with open(tmp_target, "w", encoding="latin1") as f:
            f.write(new_rtf_content)
        os.replace(tmp_target, target_rtf)
        if bak and os.path.exists(bak):
            try:
                os.remove(bak)
            except Exception:
                pass
        try:
            res_after = subprocess.run(["textutil", "-convert", "txt", "-stdin", "-stdout"],
                                       input=new_rtf_content.encode("latin1"), capture_output=True, timeout=10)
            plain_after = res_after.stdout.decode("utf-8")
            result.exported_txt_path = export_to_downloads_txt(file_path, plain_after)
        except Exception:
            pass
        result.status = "fixed"
    elif len(result.findings) > 0:
        result.status = "findings_detected"
    else:
        result.status = "clean"

    return result

def resolve_font_for_span(span: Optional[Dict[str, Any]]) -> Tuple[Optional[str], Optional[str]]:
    """Ermittelt den passenden Fontnamen oder Fontdatei-Pfad für PyMuPDF."""
    font_name = span.get("font", "").lower() if span else ""
    pt_serif_paths = [
        os.path.expanduser("~/Library/Fonts/PTSerif-Regular.ttf"),
        "/Library/Fonts/PTSerif-Regular.ttf",
        "/System/Library/Fonts/Supplemental/PTSerif-Regular.ttf"
    ]
    if "ptserif" in font_name or "pt serif" in font_name:
        for p in pt_serif_paths:
            if os.path.exists(p):
                return p, None

    if any(s in font_name for s in ["serif", "times", "garamond", "roman"]):
        for p in pt_serif_paths:
            if os.path.exists(p):
                return p, None
        return None, "times-roman"

    if any(s in font_name for s in ["sans", "helvetica", "arial"]):
        return None, "helv"

    if any(s in font_name for s in ["mono", "courier", "code"]):
        return None, "courier"

    for p in pt_serif_paths:
        if os.path.exists(p):
            return p, None
    return None, "times-roman"

def find_span_for_rect(page_dict: Optional[Dict[str, Any]], rect: Any) -> Optional[Dict[str, Any]]:
    """Ermittelt den Text-Span, der mit dem übergebenen Rect überlappt."""
    if not page_dict:
        return None
    for block in page_dict.get("blocks", []):
        for line in block.get("lines", []):
            for span in line.get("spans", []):
                s_bbox = fitz.Rect(span["bbox"])
                if s_bbox.intersects(rect):
                    return span
    return None

def audit_and_fix_pdf(file_path: str, apply_fix: bool = False, style_mode: bool = False) -> TextAuditResult:
    """Verarbeitet PDF-Dokumente: Extraktion, Audit und In-situ-Korrektur via PyMuPDF."""
    result = TextAuditResult(file_path)
    if fitz is None:
        result.findings.append({"error": "PyMuPDF ist nicht installiert. Bitte mit 'pip install pymupdf' installieren."})
        result.status = "error"
        return result

    try:
        doc = fitz.open(file_path)
    except Exception as e:
        result.findings.append({"error": f"PDF-Datei konnte nicht geöffnet werden: {e}"})
        result.status = "error"
        return result

    active_rules = get_active_rules(style_mode)
    modified = False

    for page_idx, page in enumerate(doc):
        page_raw_text = page.get_text("text")
        page_dict = page.get_text("dict") if apply_fix else None
        processed_terms_on_page = set()

        for rule in active_rules:
            pattern = re.compile(rule["pattern"])
            for match in pattern.finditer(page_raw_text):
                orig = match.group(0)
                corrected = orig

                if "replacement_map" in rule:
                    corrected = rule["replacement_map"].get(orig.lower(), orig)
                elif "replacement_str" in rule:
                    corrected = pattern.sub(rule["replacement_str"], orig)

                if orig == corrected:
                    continue

                result.findings.append({
                    "original": orig,
                    "corrected": corrected,
                    "rule": rule["rule"],
                    "reference": rule["reference"],
                    "page": page_idx + 1
                })

                if apply_fix and orig not in processed_terms_on_page:
                    processed_terms_on_page.add(orig)
                    rects = page.search_for(orig)
                    if rects:
                        for rect in rects:
                            span = find_span_for_rect(page_dict, rect) if page_dict else None
                            size = span.get("size", 11.0) if span else 11.0
                            color = span.get("color", 0) if span else 0
                            origin_y = span.get("origin", (0, rect.y1 - (rect.height * 0.18)))[1] if span else rect.y1 - (rect.height * 0.18)
                            fontfile, fontname = resolve_font_for_span(span)

                            page.add_redact_annot(rect, fill=(1, 1, 1))
                            page.apply_redactions()

                            try:
                                if fontfile:
                                    page.insert_text(fitz.Point(rect.x0, origin_y), corrected, fontsize=size, fontfile=fontfile, color=color)
                                else:
                                    page.insert_text(fitz.Point(rect.x0, origin_y), corrected, fontsize=size, fontname=fontname or "times-roman", color=color)
                                modified = True
                                result.modifications_count += 1
                            except Exception as insert_err:
                                result.findings.append({"error": f"Fehler beim Einfügen auf Seite {page_idx + 1}: {insert_err}"})

    if apply_fix and modified:
        bak = create_backup(file_path)
        tmp_target = f"{file_path}.tmp_fix_{os.getpid()}.pdf"
        try:
            doc.save(tmp_target, garbage=3, deflate=True)
            doc.close()
            os.replace(tmp_target, file_path)
            if bak and os.path.exists(bak):
                try:
                    os.remove(bak)
                except Exception:
                    pass
            try:
                doc_after = fitz.open(file_path)
                full_text_after = "\n\n".join(p.get_text("text").strip() for p in doc_after if p.get_text("text").strip())
                doc_after.close()
                result.exported_txt_path = export_to_downloads_txt(file_path, full_text_after)
            except Exception:
                pass
            result.status = "fixed"
        except Exception as save_err:
            result.findings.append({"error": f"Fehler beim Speichern der PDF: {save_err}"})
            result.status = "error"
    elif len(result.findings) > 0:
        doc.close()
        result.status = "findings_detected"
    else:
        doc.close()
        result.status = "clean"

    return result

def process_file(file_path: str, apply_fix: bool = False, style_mode: bool = False) -> TextAuditResult:
    """Wählt deterministisch den passenden Prozessor für den Dateityp."""
    if os.path.isdir(file_path) or file_path.lower().endswith(".rtfd"):
        return audit_and_fix_rtf(file_path, apply_fix=apply_fix, style_mode=style_mode)
    ext = os.path.splitext(file_path)[1].lower()
    if ext == ".docx":
        return audit_and_fix_docx(file_path, apply_fix=apply_fix, style_mode=style_mode)
    elif ext in [".txt", ".md", ".typ"]:
        return audit_and_fix_plain(file_path, apply_fix=apply_fix, style_mode=style_mode)
    elif ext == ".rtf":
        return audit_and_fix_rtf(file_path, apply_fix=apply_fix, style_mode=style_mode)
    elif ext == ".pdf":
        return audit_and_fix_pdf(file_path, apply_fix=apply_fix, style_mode=style_mode)
    else:
        res = TextAuditResult(file_path)
        res.findings.append({"error": f"Nicht unterstützter Dateityp: {ext}"})
        res.status = "unsupported"
        return res

def normalize_cli_args(raw_args):
    """Normalisiert CLI-Argumente, sodass -s, -a, -j auch als Standalone-Flags ohne Wert übergeben werden können."""
    style_keywords = {"all", "floskeln", "pleonasmen", "nominalstil"}
    audit_keywords = {"detail", "summary"}
    json_keywords = {"pretty", "compact"}
    norm = []
    i = 0
    while i < len(raw_args):
        a = raw_args[i]
        norm.append(a)
        if a == "-s":
            if i + 1 >= len(raw_args) or raw_args[i + 1].startswith("-") or raw_args[i + 1].lower() not in style_keywords:
                norm.append("all")
        elif a == "-a":
            if i + 1 >= len(raw_args) or raw_args[i + 1].startswith("-") or raw_args[i + 1].lower() not in audit_keywords:
                norm.append("detail")
        elif a == "-j":
            if i + 1 >= len(raw_args) or raw_args[i + 1].startswith("-") or raw_args[i + 1].lower() not in json_keywords:
                norm.append("pretty")
        i += 1
    return norm

class SingleLineHelpFormatter(argparse.HelpFormatter):
    def _split_lines(self, text, width):
        return [text]

def main():
    parser = argparse.ArgumentParser(
        prog="txt-korrigieren",
        formatter_class=lambda prog: SingleLineHelpFormatter(prog, max_help_position=16, width=220),
        description="Deterministische Text-, Orthografie- und Stilkorrektur nach Duden und amtlichem Regelwerk.",
        add_help=False
    )
    parser.add_argument("-h", action="help", help="Hilfe anzeigen")
    parser.add_argument("-s", dest="style_mode", metavar="STIL", default=None, help="Stil- und Idiomatikkorrektur (all; floskeln, pleonasmen, nominalstil)")
    parser.add_argument("-a", dest="audit_mode", metavar="MODUS", default=None, help="Prüflauf ohne Schreibzugriff (detail, summary)")
    parser.add_argument("-o", dest="output", metavar="AUSGABE", default=None, help="Optionaler Ausgabepfad (.txt)")
    parser.add_argument("-j", dest="json_format", metavar="FORMAT", default=None, help="Ausgabe im JSON-Format (pretty, compact)")
    parser.add_argument("file", metavar="DATEI", help="Text-, Word-, PDF- oder RTF/RTFD-Datei (.txt/.md/.docx/.typ/.rtf/.rtfd/.pdf)")

    normalized_args = normalize_cli_args(sys.argv[1:])
    args = parser.parse_args(normalized_args)
    file_path = os.path.abspath(os.path.expanduser(args.file))

    if not os.path.exists(file_path):
        sys.stderr.write(f"Fehler: Datei existiert nicht: {file_path}\n")
        sys.exit(1)

    apply_fix = args.audit_mode is None
    style_mode = args.style_mode
    result = process_file(file_path, apply_fix=apply_fix, style_mode=style_mode)

    if args.output and result.exported_txt_path and os.path.exists(result.exported_txt_path):
        try:
            shutil.copy2(result.exported_txt_path, args.output)
            result.exported_txt_path = args.output
        except Exception:
            pass

    if args.json_format:
        indent = 2 if args.json_format == "pretty" else None
        separators = None if args.json_format == "pretty" else (",", ":")
        print(json.dumps(result.to_dict(), ensure_ascii=False, indent=indent, separators=separators))
    else:
        print("=== Textkorrektur-Engine (txt-korrigieren) ===")
        print(f"Datei: {result.file_path}")
        print(f"Status: {result.status.upper()}")
        print(f"Befunde: {len(result.findings)}")
        if result.backup_path:
            print(f"Backup erstellt: {result.backup_path}")
        if result.exported_txt_path:
            print(f"Exportiert (.txt): {result.exported_txt_path}")
        print(f"Modifikationen: {result.modifications_count}")
        print("\nDetailierte Befunde:")
        for idx, f in enumerate(result.findings, 1):
            if "error" in f:
                print(f" [{idx}] FEHLER: {f['error']}")
            else:
                orig = f.get('original', '')
                corr = f.get('corrected', '')
                ref = f.get('reference', '')
                print(f" [{idx}] '{orig}' -> '{corr}' | {ref}")

if __name__ == "__main__":
    main()
