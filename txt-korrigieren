# macOS NSSpellChecker C-Bridge (O(1) nativer SpellChecker)
# ---------------------------------------------------------------------------
class SpellFinding(ctypes.Structure):
    _fields_ = [
        ('location', ctypes.c_long),
        ('length', ctypes.c_long),
        ('word', ctypes.c_char * 256),
        ('best_guess', ctypes.c_char * 256),
        ('guess_count', ctypes.c_int)
    ]

_SPELL_LIB = None
_SPELL_LIB_INITIALIZED = False

def get_spell_lib():
    global _SPELL_LIB, _SPELL_LIB_INITIALIZED
    if _SPELL_LIB_INITIALIZED:
        return _SPELL_LIB
    _SPELL_LIB_INITIALIZED = True

    if sys.platform != 'darwin':
        return None

    # Suche nach kompilierter dylib in bekannten Pfaden
    dylib_candidates = [
        os.path.join(BASE_DIR, "libspell.dylib"),
        os.path.join(SCRIPTS_DIR, "libspell.dylib"),
        os.path.expanduser("~/.local/lib/libspell.dylib"),
        os.path.expanduser("~/.local/bin/libspell.dylib"),
    ]
    dylib_path = None
    for cand in dylib_candidates:
        if os.path.exists(cand):
            dylib_path = cand
            break

    # Falls noch nicht gebaut, aber C/ObjC-Source vorhanden, ad-hoc kompilieren
    if not dylib_path:
        source_candidates = [
            os.path.join(BASE_DIR, "spell_bridge.m"),
            os.path.join(SCRIPTS_DIR, "spell_bridge.m"),
        ]
        source_path = next((s for s in source_candidates if os.path.exists(s)), None)
        if source_path:
            out_target = os.path.join(os.path.dirname(source_path), "libspell.dylib")
            try:
                subprocess.run(
                    ["clang", "-dynamiclib", "-O3", "-framework", "Cocoa", source_path, "-o", out_target],
                    capture_output=True, timeout=10
                )
                if os.path.exists(out_target):
                    dylib_path = out_target
            except Exception:
                dylib_path = None

    if dylib_path and os.path.exists(dylib_path):
        try:
            lib = ctypes.cdll.LoadLibrary(dylib_path)
            lib.check_text_de.argtypes = [ctypes.c_char_p, ctypes.POINTER(SpellFinding), ctypes.c_int]
            lib.check_text_de.restype = ctypes.c_int
            lib.is_valid_word_de.argtypes = [ctypes.c_char_p]
            lib.is_valid_word_de.restype = ctypes.c_int
            _SPELL_LIB = lib
        except Exception:
            _SPELL_LIB = None

    return _SPELL_LIB

