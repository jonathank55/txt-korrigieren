def get_active_rules(style_mode: Any = None) -> List[Dict[str, Any]]:
    if not style_mode:
        return list(DETERMINISTIC_RULES)
    mode = str(style_mode).lower().strip()
    if mode in ["all", "ja", "true", "1"]:
        return DETERMINISTIC_RULES + STYLE_RULES
    elif mode == "floskeln":
        return DETERMINISTIC_RULES + [r for r in STYLE_RULES if "Floskel" in r["rule"] or "Nominalstil" in r["rule"]]
    elif mode == "pleonasmen":
        return DETERMINISTIC_RULES + [r for r in STYLE_RULES if "Pleonasmus" in r["rule"] or "Tautologie" in r["rule"]]
    elif mode == "nominalstil":
        return DETERMINISTIC_RULES + [r for r in STYLE_RULES if "Nominalstil" in r["rule"] or "Funktionsverb" in r["rule"]]
    return DETERMINISTIC_RULES + STYLE_RULES

def create_backup(file_path: str) -> Optional[str]:
    """Erstellt eine atomare .bak-Sicherung und registriert sie im zentralen Archiv."""
    if not os.path.exists(file_path):
        return None
    
    bak_path = f"{file_path}.bak"
    try:
        shutil.copy2(file_path, bak_path)
    except Exception as e:
        sys.stderr.write(f"[BACKUP_ERROR] Lokales Backup fehlgeschlagen: {e}\n")
        return None

    if os.path.exists(BACKUP_SCRIPT):
        try:
            subprocess.run([sys.executable, BACKUP_SCRIPT, file_path], capture_output=True, timeout=60)
        except Exception:
            pass
    return bak_path

def export_to_downloads_txt(file_path: str, text_content: str) -> str:
    """Exportiert den bereinigten Text als .txt-Datei direkt im Downloads-Ordner."""
    downloads_dir = os.path.expanduser("~/Downloads")
    os.makedirs(downloads_dir, exist_ok=True)
    base_name = os.path.splitext(os.path.basename(file_path))[0]
    out_path = os.path.join(downloads_dir, f"{base_name}.txt")
    with open(out_path, "w", encoding="utf-8") as f:
        f.write(text_content)
    return out_path

class TextAuditResult:
    def __init__(self, file_path: str):
        self.file_path = file_path
        self.file_type = os.path.splitext(file_path)[1].lower()
        self.findings: List[Dict[str, Any]] = []
        self.modifications_count = 0
        self.status = "clean"
        self.backup_path: Optional[str] = None
        self.exported_txt_path: Optional[str] = None

    def to_dict(self) -> Dict[str, Any]:
        return {
            "file_path": self.file_path,
            "file_type": self.file_type,
            "status": self.status,
            "modifications_count": self.modifications_count,
            "backup_path": self.backup_path,
            "exported_txt_path": self.exported_txt_path,
            "findings_count": len(self.findings),
            "findings": self.findings
        }

def scan_spelling_errors(text: str) -> List[Dict[str, Any]]:
    """Scannt Text mittels nativer NSSpellChecker-Bridge nach echten Orthografiefehlern."""
    lib = get_spell_lib()
    if not lib:
        return []

    findings = []
    max_findings = 1000
    spell_findings = (SpellFinding * max_findings)()
    
    try:
        count = lib.check_text_de(text.encode('utf-8'), spell_findings, max_findings)
    except Exception:
        return []

    for i in range(count):
        raw_word = spell_findings[i].word.decode('utf-8')
        raw_guess = spell_findings[i].best_guess.decode('utf-8')
        guess_cnt = spell_findings[i].guess_count

        clean_word = raw_word.strip(".,;:!?\"'()[]{}«»„“")
        norm_word = clean_word.lower()

        # 1. Ignorierfilter für URLs, Zahlen, Bindestriche und geschützte Eigennamen
        if not clean_word or len(clean_word) < 4:
            continue
        if norm_word in PROTECTED_TOKENS:
            continue
        if any(c.isdigit() for c in clean_word) or "/" in clean_word or "." in clean_word or "@" in clean_word:
            continue
        
        # 2. Toleranz für grammatikalisch korrekte Wortschöpfungen & Suffixableitungen
        if clean_word.endswith(("los", "lose", "loser", "losen", "bar", "bare", "baren", "barkeit", "ung", "ungen", "heit", "keiten")):
            # Wenn der Stamm valide ist, ignorieren (Zero Style-Tampering)
            continue

        if guess_cnt > 0 and raw_guess:
            clean_guess = raw_guess.strip(".,;:!?\"'()[]{}«»„“")
            # Prüfe Levenshtein-Distanz
            dist = levenshtein(norm_word, clean_guess.lower())
            
            # Maximaldistanz: 2 für normale Wörter, 3 für sehr lange Wörter (> 12 Zeichen)
            max_dist = 3 if len(clean_word) >= 12 else 2
            
            if 0 < dist <= max_dist:
                # Behalte Groß-/Kleinschreibung des Originals bei
                if clean_word[0].isupper() and clean_guess[0].islower():
                    clean_guess = clean_guess.capitalize()
                elif clean_word[0].islower() and clean_guess[0].isupper():
                    clean_guess = clean_guess.lower()

                findings.append({
                    "original": clean_word,
                    "corrected": clean_guess,
                    "rule": "Laut-Buchstaben-Zuordnung § 25",
                    "reference": f"Duden / Amtliches Regelwerk § 25: Normgerechte Orthografie von '{clean_guess}'."
                })

    return findings

def audit_and_fix_plain(file_path: str, apply_fix: bool = False, style_mode: bool = False) -> TextAuditResult:
    """Verarbeitet Text-, Markdown- und Typst-Dateien."""
    active_rules = get_active_rules(style_mode)
    result = TextAuditResult(file_path)
    try:
        with open(file_path, "r", encoding="utf-8") as f:
            content = f.read()
    except Exception as e:
        result.findings.append({"error": f"Datei konnte nicht gelesen werden: {e}"})
        result.status = "error"
        return result

    new_content = content
    modified = False

    # 1. Deterministische Regeln anwenden
    for rule in active_rules:
        pattern = re.compile(rule["pattern"])
        for match in pattern.finditer(new_content):
            orig = match.group(0)
            corrected = orig

            if "replacement_func" in rule:
                corrected = rule["replacement_func"](match)
            elif "replacement_map" in rule:
                corrected = rule["replacement_map"].get(orig.lower(), orig)
            elif "replacement_str" in rule:
                corrected = pattern.sub(rule["replacement_str"], orig)

            if orig == corrected:
                continue

            # Dopplungen vermeiden
            if any(f.get("original") == orig and f.get("corrected") == corrected for f in result.findings):
                continue

            result.findings.append({
                "original": orig,
                "corrected": corrected,
                "rule": rule["rule"],
                "reference": rule["reference"]
            })

            if apply_fix and corrected != orig:
                new_content = new_content.replace(orig, corrected, 1)
                modified = True
                result.modifications_count += 1

    # 2. Natives NSSpellChecker-Scanning nach echten Orthografiefehlern
    spell_findings = scan_spelling_errors(new_content)
    for sf in spell_findings:
        orig = sf["original"]
        corr = sf["corrected"]

        # Prüfe ob bereits erfasst
        if any(f.get("original") == orig for f in result.findings):
            continue

        result.findings.append(sf)
        if apply_fix and orig != corr and orig in new_content:
            # Sichere Wortgrenzen-Ersetzung
            word_pattern = re.compile(r'\b' + re.escape(orig) + r'\b')
            new_content = word_pattern.sub(corr, new_content)
            modified = True
            result.modifications_count += 1

    if apply_fix and modified:
        bak = create_backup(file_path)
        tmp_target = f"{file_path}.tmp_fix_{os.getpid()}"
        with open(tmp_target, "w", encoding="utf-8") as f:
            f.write(new_content)
        os.replace(tmp_target, file_path)
        
        # Obligatorische Bereinigung: Lokale .bak nach erfolgreicher Speicherung löschen
        if bak and os.path.exists(bak):
            try:
                os.remove(bak)
            except Exception:
                pass

        try:
            result.exported_txt_path = export_to_downloads_txt(file_path, new_content)
        except Exception:
            pass
        result.status = "fixed"
    elif len(result.findings) > 0:
        result.status = "findings_detected"
    else:
        result.status = "clean"

    return result

def audit_and_fix_docx(file_path: str, apply_fix: bool = False, style_mode: bool = False) -> TextAuditResult:
    """Verarbeitet .docx-Dokumente formatgetreu über Runs und Absätze."""
    active_rules = get_active_rules(style_mode)
    result = TextAuditResult(file_path)
    try:
        import docx
    except ImportError:
        result.findings.append({"error": "Bibliothek python-docx nicht verfügbar."})
        result.status = "error"
        return result

    try:
        doc = docx.Document(file_path)
    except Exception as e:
        result.findings.append({"error": f"Word-Datei konnte nicht geladen werden: {e}"})
        result.status = "error"
        return result

    modified = False

    for p_idx, p in enumerate(doc.paragraphs):
        p_text = p.text
        if not p_text.strip():
            continue

        # 1. Deterministische Regeln
        for rule in active_rules:
            pattern = re.compile(rule["pattern"])
            for match in pattern.finditer(p_text):
                orig = match.group(0)
                corrected = orig

                if "replacement_func" in rule:
                    corrected = rule["replacement_func"](match)
                elif "replacement_map" in rule:
                    corrected = rule["replacement_map"].get(orig.lower(), orig)
                elif "replacement_str" in rule:
                    corrected = pattern.sub(rule["replacement_str"], orig)

                if orig == corrected:
                    continue

                finding = {
                    "original": orig,
                    "corrected": corrected,
                    "rule": rule["rule"],
                    "reference": rule["reference"],
                    "paragraph": p_idx
                }
                result.findings.append(finding)

                if apply_fix:
                    for r in p.runs:
                        if orig in r.text:
                            r.text = r.text.replace(orig, corrected, 1)
                            modified = True
                            result.modifications_count += 1
                            break

        # 2. SpellChecker
        spell_findings = scan_spelling_errors(p.text)
        for sf in spell_findings:
            orig = sf["original"]
            corr = sf["corrected"]
            if any(f.get("original") == orig for f in result.findings):
                continue
            sf["paragraph"] = p_idx
            result.findings.append(sf)

            if apply_fix:
                for r in p.runs:
                    if orig in r.text:
                        r.text = re.sub(r'\b' + re.escape(orig) + r'\b', corr, r.text)
                        modified = True
                        result.modifications_count += 1
                        break

    if apply_fix and modified:
        bak = create_backup(file_path)
        doc.save(file_path)
        if bak and os.path.exists(bak):
            try:
                os.remove(bak)
            except Exception:
                pass
        try:
            full_text = "\n\n".join(p.text for p in doc.paragraphs if p.text.strip())
            result.exported_txt_path = export_to_downloads_txt(file_path, full_text)
        except Exception:
            pass
        result.status = "fixed"
    elif len(result.findings) > 0:
        result.status = "findings_detected"
    else:
        result.status = "clean"

    return result

def to_rtf_escapes(s: str) -> str:
    char_map = {
        'ä': r"\'e4", 'ö': r"\'f6", 'ü': r"\'fc",
        'Ä': r"\'c4", 'Ö': r"\'d6", 'Ü': r"\'dc",
        'ß': r"\'df", '–': r"\endash ", '—': r"\emdash ",
        '„': r"\'84", '“': r"\'93", '”': r"\'94"
    }
    out = []
    for c in s:
        if c in char_map:
            out.append(char_map[c])
        elif ord(c) > 127:
            out.append(f"\\u{ord(c)}?")
        else:
            out.append(c)
    return "".join(out)

def audit_and_fix_rtf(file_path: str, apply_fix: bool = False, style_mode: bool = False) -> TextAuditResult:
    """Verarbeitet RTF-Dateien sowie RTFD-Bundles."""
    active_rules = get_active_rules(style_mode)
    result = TextAuditResult(file_path)
    
    is_bundle = os.path.isdir(file_path) or file_path.lower().endswith(".rtfd")
    target_rtf = os.path.join(file_path, "TXT.rtf") if is_bundle else file_path
    
    if not os.path.exists(target_rtf):
        result.findings.append({"error": f"RTF-Zieldatei existiert nicht: {target_rtf}"})
        result.status = "error"
        return result

    try:
        with open(target_rtf, "r", encoding="latin1") as f:
            rtf_content = f.read()
    except Exception as e:
        result.findings.append({"error": f"RTF-Datei konnte nicht gelesen werden: {e}"})
        result.status = "error"
        return result

    try:
        res = subprocess.run(["textutil", "-convert", "txt", "-stdin", "-stdout"],
                             input=rtf_content.encode("latin1"), capture_output=True, timeout=10)
        plain_text = res.stdout.decode("utf-8")
    except Exception:
        plain_text = rtf_content

    new_rtf_content = rtf_content
    modified = False

    for rule in active_rules:
        pattern = re.compile(rule["pattern"])
        for match in pattern.finditer(plain_text):
            orig = match.group(0)
            corrected = orig

            if "replacement_func" in rule:
                corrected = rule["replacement_func"](match)
            elif "replacement_map" in rule:
                corrected = rule["replacement_map"].get(orig.lower(), orig)
            elif "replacement_str" in rule:
                corrected = pattern.sub(rule["replacement_str"], orig)

            if orig == corrected:
                continue

            result.findings.append({
                "original": orig,
                "corrected": corrected,
                "rule": rule["rule"],
                "reference": rule["reference"]
            })

            if apply_fix and corrected != orig:
                if orig in new_rtf_content:
                    new_rtf_content = new_rtf_content.replace(orig, corrected, 1)
                    modified = True
                    result.modifications_count += 1
                else:
                    orig_rtf = to_rtf_escapes(orig)
                    corr_rtf = to_rtf_escapes(corrected)
                    if orig_rtf in new_rtf_content:
                        new_rtf_content = new_rtf_content.replace(orig_rtf, corr_rtf, 1)
                        modified = True
                        result.modifications_count += 1

    spell_findings = scan_spelling_errors(plain_text)
    for sf in spell_findings:
        orig = sf["original"]
        corr = sf["corrected"]
        if any(f.get("original") == orig for f in result.findings):
            continue
        result.findings.append(sf)

        if apply_fix:
            if orig in new_rtf_content:
                new_rtf_content = re.sub(r'\b' + re.escape(orig) + r'\b', corr, new_rtf_content, count=1)
                modified = True
                result.modifications_count += 1
            else:
                orig_rtf = to_rtf_escapes(orig)
                corr_rtf = to_rtf_escapes(corr)
                if orig_rtf in new_rtf_content:
                    new_rtf_content = new_rtf_content.replace(orig_rtf, corr_rtf, 1)
                    modified = True
                    result.modifications_count += 1

    if apply_fix and modified:
        bak = create_backup(target_rtf)
        tmp_target = f"{target_rtf}.tmp_fix_{os.getpid()}"
        with open(tmp_target, "w", encoding="latin1") as f:
            f.write(new_rtf_content)
        os.replace(tmp_target, target_rtf)
        if bak and os.path.exists(bak):
            try:
                os.remove(bak)
            except Exception:
                pass
        try:
            res_after = subprocess.run(["textutil", "-convert", "txt", "-stdin", "-stdout"],
                                       input=new_rtf_content.encode("latin1"), capture_output=True, timeout=10)
            plain_after = res_after.stdout.decode("utf-8")
            result.exported_txt_path = export_to_downloads_txt(file_path, plain_after)
        except Exception:
            pass
        result.status = "fixed"
    elif len(result.findings) > 0:
        result.status = "findings_detected"
    else:
        result.status = "clean"

    return result

def process_file(file_path: str, apply_fix: bool = False, style_mode: bool = False) -> TextAuditResult:
    if os.path.isdir(file_path) or file_path.lower().endswith(".rtfd"):
        return audit_and_fix_rtf(file_path, apply_fix=apply_fix, style_mode=style_mode)
    ext = os.path.splitext(file_path)[1].lower()
    if ext == ".docx":
        return audit_and_fix_docx(file_path, apply_fix=apply_fix, style_mode=style_mode)
    elif ext in [".txt", ".md", ".typ"]:
        return audit_and_fix_plain(file_path, apply_fix=apply_fix, style_mode=style_mode)
    elif ext == ".rtf":
        return audit_and_fix_rtf(file_path, apply_fix=apply_fix, style_mode=style_mode)
    else:
        res = TextAuditResult(file_path)
        res.findings.append({"error": f"Nicht unterstützter Dateityp: {ext}"})
        res.status = "unsupported"
        return res

def normalize_cli_args(raw_args):
    style_keywords = {"all", "floskeln", "pleonasmen", "nominalstil"}
    audit_keywords = {"detail", "summary"}
    json_keywords = {"pretty", "compact"}
    norm = []
    i = 0
    while i < len(raw_args):
        a = raw_args[i]
        norm.append(a)
        if a == "-s":
            if i + 1 >= len(raw_args) or raw_args[i + 1].startswith("-") or raw_args[i + 1].lower() not in style_keywords:
                norm.append("all")
        elif a == "-a":
            if i + 1 >= len(raw_args) or raw_args[i + 1].startswith("-") or raw_args[i + 1].lower() not in audit_keywords:
                norm.append("detail")
        elif a == "-j":
            if i + 1 >= len(raw_args) or raw_args[i + 1].startswith("-") or raw_args[i + 1].lower() not in json_keywords:
                norm.append("pretty")
        i += 1
    return norm

class SingleLineHelpFormatter(argparse.HelpFormatter):
    def _split_lines(self, text, width):
        return [text]

def main():
    parser = argparse.ArgumentParser(
        prog="txt-korrigieren",
        formatter_class=lambda prog: SingleLineHelpFormatter(prog, max_help_position=16, width=220),
        description="Deterministische Text-, Orthografie- und Stilkorrektur nach Duden und amtlichem Regelwerk.",
        add_help=False
    )
    parser.add_argument("-h", action="help", help="Hilfe anzeigen")
    parser.add_argument("-s", dest="style_mode", metavar="STIL", default=None, help="Stil- und Idiomatikkorrektur (all; floskeln, pleonasmen, nominalstil)")
    parser.add_argument("-a", dest="audit_mode", metavar="MODUS", default=None, help="Prüflauf ohne Schreibzugriff (detail, summary)")
    parser.add_argument("-o", dest="output", metavar="AUSGABE", default=None, help="Optionaler Ausgabepfad (.txt)")
    parser.add_argument("-j", dest="json_format", metavar="FORMAT", default=None, help="Ausgabe im JSON-Format (pretty, compact)")
    parser.add_argument("file", metavar="DATEI", help="Text-, Word- oder RTF/RTFD-Datei (.txt/.md/.docx/.typ/.rtf/.rtfd)")

    normalized_args = normalize_cli_args(sys.argv[1:])
    args = parser.parse_args(normalized_args)
    file_path = os.path.abspath(os.path.expanduser(args.file))

    if not os.path.exists(file_path):
        sys.stderr.write(f"Fehler: Datei existiert nicht: {file_path}\n")
        sys.exit(1)

    apply_fix = args.audit_mode is None
    style_mode = args.style_mode
    result = process_file(file_path, apply_fix=apply_fix, style_mode=style_mode)

    if args.output and result.exported_txt_path and os.path.exists(result.exported_txt_path):
        try:
            shutil.copy2(result.exported_txt_path, args.output)
            result.exported_txt_path = args.output
        except Exception:
            pass

    if args.json_format:
        indent = 2 if args.json_format == "pretty" else None
        separators = None if args.json_format == "pretty" else (",", ":")
        print(json.dumps(result.to_dict(), ensure_ascii=False, indent=indent, separators=separators))
    else:
        print("=== Textkorrektur-Engine (txt-korrigieren) ===")
        print(f"Datei: {result.file_path}")
        print(f"Status: {result.status.upper()}")
        print(f"Befunde: {len(result.findings)}")
        if result.backup_path:
            print(f"Backup erstellt: {result.backup_path}")
        if result.exported_txt_path:
            print(f"Exportiert (.txt): {result.exported_txt_path}")
        print(f"Modifikationen: {result.modifications_count}")
        print("\nDetailierte Befunde:")
        for idx, f in enumerate(result.findings, 1):
            if "error" in f:
                print(f" [{idx}] FEHLER: {f['error']}")
            else:
                orig = f.get('original', '')
                corr = f.get('corrected', '')
                ref = f.get('reference', '')
                print(f" [{idx}] '{orig}' -> '{corr}' | {ref}")

if __name__ == "__main__":
    main()
